SUPABASE_URL=https://xxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
PORT=3001
CORS_ORIGIN=http://localhost:8080,https://yoyoparty.lovable.app,https://yoyoparty.ro,https://www.yoyoparty.ro

# Legacy alias (optional):
# SUPABASE_ANON_KEY=your_publishable_key

# Required for admin claim approve + cleanup (bypasses user RLS when assigning membership)
# SUPABASE_SERVICE_ROLE_KEY=

# Google Calendar FreeBusy (optional until someone connects)
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# Must match Google Cloud OAuth redirect; SPA completes code exchange on this URL
# GOOGLE_CALENDAR_REDIRECT_URI=https://yoyoparty.ro/provider/profile
# Encrypts refresh tokens + signs OAuth state (min 16 chars)
# TOKEN_ENCRYPTION_KEY=
